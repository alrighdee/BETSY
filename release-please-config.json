{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "BETSY",
      "changelog-path": "CHANGELOG.md",
      "bump-minor-pre-major": false,
      "bump-patch-for-minor-pre-major": true,
      "extra-files": [
        "app/build.gradle.kts"
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Added"
        },
        {
          "type": "fix",
          "section": "Fixed"
        },
        {
          "type": "perf",
          "section": "Changed"
        },
        {
          "type": "refactor",
          "section": "Changed"
        },
        {
          "type": "revert",
          "section": "Removed"
        },
        {
          "type": "deprecate",
          "section": "Deprecated"
        },
        {
          "type": "security",
          "section": "Security"
        },
        {
          "type": "docs",
          "section": "Documentation"
        },
        {
          "type": "build",
          "hidden": true
        },
        {
          "type": "ci",
          "hidden": true
        },
        {
          "type": "chore",
          "hidden": true
        },
        {
          "type": "style",
          "hidden": true
        },
        {
          "type": "test",
          "hidden": true
        }
      ],
      "initial-version": "0.0.1",
      "include-component-in-tag": false
    }
  }
}
